NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gacha_user
DB_PASSWORD=your_password_here
DB_DATABASE=gacha_vault_db
# Generate a strong secret per-environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER commit the real value used in staging/production.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=3600
PORT=3000

# Shipping rehearsal only; production mutations remain disabled even if true.
ENABLE_SHIPPING_PREVIEW=false
# Explicit server tariff required. The following is an example, NOT an approved fee.
# SHIPPING_RATE_TABLE_JSON=[{"id":"test","label":"Test only","prefixes":["*"],"feeGP":3000}]
# Only items explicitly classified PHYSICAL with shipping_enabled=true are eligible.

# Unopened-capsule refund rehearsal; production stays disabled even if true.
ENABLE_ORDER_REFUND_PREVIEW=false
# Explicit business-day coverage is required for STANDARD sales. This empty
# holiday list is a TEST EXAMPLE, not the approved Korean business calendar.
# REFUND_CALENDAR_JSON={"coverageStart":"2026-01-01","coverageEnd":"2027-12-31","holidays":[]}

# Direct Danal ONE API card integration: test keys only, never live credentials.
ENABLE_DANAL_TEST_PAYMENTS=false
# PUBLIC_API_ORIGIN=https://gacha-vault-backend.onrender.com
# DANAL_MERCHANT_ID=<your-test-merchant-id>
# DANAL_CLIENT_KEY=<your-CL_TEST-client-key>
# DANAL_SECRET_KEY=<your-SK_TEST-secret-key>
# Cash catalog sales also require cash_enabled=true and an explicit KRW price.
