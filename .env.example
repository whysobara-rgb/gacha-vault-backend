NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gacha_user
DB_PASSWORD=your_password_here
DB_DATABASE=gacha_vault_db
# Generate a strong secret per-environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER commit the real value used in staging/production.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=3600
PORT=3000

# --- Social login ---------------------------------------------------------
# A provider is offered (GET /auth/providers) only when its config is set;
# tokens are always verified with the provider, never trusted as sent.
KAKAO_APP_ID=          # 카카오 디벨로퍼스 앱 ID (숫자). 다른 앱에서 발급된 토큰을 거부하는 데 사용
NAVER_CLIENT_ID=       # 네이버 로그인 Client ID
GOOGLE_CLIENT_IDS=     # iOS/Android/Web OAuth 클라이언트 ID, 쉼표로 구분
APPLE_CLIENT_IDS=      # 앱 번들 ID / Services ID, 쉼표로 구분
