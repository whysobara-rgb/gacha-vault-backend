NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=gacha_user
DB_PASSWORD=your_password_here
DB_DATABASE=gacha_vault_db
# Generate a strong secret per-environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# NEVER commit the real value used in staging/production.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=3600
PORT=3000
